# Copy to the ignored .env.publication.local file.
# local: build the public site and verify http://127.0.0.1:8080.
# cloudbase: delegate deployment to the existing CloudBase configuration.
# When unset, cloudbase is retained for compatibility.
WAGMI_PUBLICATION_MODE=local

# Public access remains separate from local deployment.
# WAGMI_PUBLIC_URL stays in .env.dingtalk.local (or the process environment).
# Use --verify-public to verify that address; local success alone never enables sending.
