# Backend only. Copy to .env.ai-lab.local and provide your own key there.
AI_LAB_API_KEY=
AI_LAB_GATEWAY_WIRE_MODE=responses
# Enable only after a successful image probe against this exact gateway/model.
AI_LAB_GATEWAY_IMAGE_VERIFIED=0
AI_LAB_MODEL_TIMEOUT=180
AI_LAB_MAX_OUTPUT_TOKENS=12000
# Optional Responses control. Empty/unset keeps the provider's default.
# none was gateway-tested; faster completion does not establish floorplan quality.
# AI_LAB_REASONING_EFFORT=none
