# Copy to .env.ai-lab.local (Git ignored). Backend-only; never use VITE_ keys.
AI_LAB_EXECUTION_MODE=codex_handoff
AI_LAB_BANANAROUTER_KEY=
AI_LAB_API_BASE_URL=https://api.bananarouter.com/v1
AI_LAB_API_MODEL=gpt-6.1-sol
AI_LAB_API_REASONING_EFFORT=max
AI_LAB_API_MAX_OUTPUT_TOKENS=65536
AI_LAB_API_TIMEOUT=900
# Set to 1 only after an actual synthetic image capability check.
AI_LAB_API_IMAGE_VERIFIED=0
AI_LAB_WORKFLOW_MAX_CALLS=12
AI_LAB_WORKFLOW_MAX_REPAIRS=4
AI_LAB_WORKFLOW_MAX_REVIEWS=4

# Historical gateway diagnostics only. Never selected as an API fallback.
AI_LAB_API_KEY=
AI_LAB_GATEWAY_WIRE_MODE=responses
AI_LAB_JSON_MODE=1
AI_LAB_GATEWAY_IMAGE_VERIFIED=0
AI_LAB_MODEL_TIMEOUT=180
AI_LAB_MAX_OUTPUT_TOKENS=12000
