# Default runtime is current Codex chat handoff. No API key, CLI login or SDK
# is required, and the webpage never starts automatic inference.
# Legacy gateway variables below are retained only for historical offline
# provider tests; they cannot activate that provider in the default runtime.
# Keep any existing private key/history untouched; there is no fallback.
AI_LAB_API_KEY=
AI_LAB_GATEWAY_WIRE_MODE=responses
# Verified for this gateway/model; keep data output valid JSON.
AI_LAB_JSON_MODE=1
# Enable only after a successful image probe against this exact gateway/model.
AI_LAB_GATEWAY_IMAGE_VERIFIED=0
AI_LAB_MODEL_TIMEOUT=180
AI_LAB_MAX_OUTPUT_TOKENS=12000
# Optional Responses control. Empty/unset keeps the provider's default.
# none was gateway-tested; faster completion does not establish floorplan quality.
# AI_LAB_REASONING_EFFORT=none
# Optional bounded full-workflow budgets; fixed when each job is created.
AI_LAB_WORKFLOW_MAX_CALLS=8
AI_LAB_WORKFLOW_MAX_REPAIRS=2
AI_LAB_WORKFLOW_MAX_REVIEWS=2
