{
  "name": "wagmi-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:lab-public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-public-ai-lab.ps1",
    "dev:lab": "vite --config vite.ai-lab.config.ts --mode lab",
    "build:lab": "tsc -b && vite build --config vite.ai-lab.config.ts --mode lab",
    "dev": "npm run dev:admin",
    "dev:admin": "vite --host 127.0.0.1 --port 5174 --strictPort --mode admin",
    "dev:public": "vite --host 127.0.0.1 --mode public",
    "data:validate": "node scripts/validate-data.mjs data/main/index.json",
    "data:validate-dev": "node scripts/validate-dev-data.mjs",
    "data:history:import": "node scripts/import-ai-history.mjs",
    "data:history:audit": "node scripts/backfill-daily-report-gaps.mjs",
    "data:promote:check": "node scripts/promote-dev-to-main.mjs --check",
    "data:promote": "node scripts/promote-dev-to-main.mjs --write",
    "data:daily:check": "node scripts/daily-main-publish.mjs --check",
    "data:daily:publish": "node scripts/daily-main-publish.mjs --write",
    "data:sync-main": "npm run data:validate && node scripts/sync-main-data.mjs",
    "github:discover": "node scripts/discover-github-trends.mjs",
    "github:discover:dry": "node scripts/discover-github-trends.mjs --dry-run",
    "github:sync-industry": "node scripts/sync-github-industry-watchlist.mjs",
    "github:sync-industry:dry": "node scripts/sync-github-industry-watchlist.mjs --dry-run",
    "memene:discover": "node scripts/discover-memene-daily.mjs",
    "memene:discover:dry": "node scripts/discover-memene-daily.mjs --dry-run",
    "papers:discover": "node scripts/discover-ai-papers.mjs",
    "papers:discover:dry": "node scripts/discover-ai-papers.mjs --dry-run",
    "papers:catalog": "node scripts/sync-paper-catalog.mjs",
    "papers:catalog:dry": "node scripts/sync-paper-catalog.mjs --dry-run",
    "papers:refresh": "npm run papers:discover && npm run papers:catalog",
    "ai:localize": "node scripts/apply-ai-event-translations.mjs",
    "ai:weekly:rebuild": "node scripts/rebuild-ai-weekly.mjs",
    "skills:discover": "node --disable-warning=ExperimentalWarning scripts/sync-skills-catalog.mjs",
    "skills:discover:dry": "node --disable-warning=ExperimentalWarning scripts/sync-skills-catalog.mjs --dry-run --max-pages=1",
    "notify:dingtalk": "node scripts/send-dingtalk-digest.mjs",
    "notify:dingtalk:check": "node scripts/send-dingtalk-digest.mjs --check",
    "notify:dingtalk:run": "node scripts/send-dingtalk-digest.mjs --supplement",
    "notify:dingtalk:dry": "node scripts/send-dingtalk-digest.mjs --dry-run",
    "notify:dingtalk:test": "node scripts/send-dingtalk-digest.mjs --test-connection",
    "notify:dingtalk:preview": "node scripts/send-dingtalk-digest.mjs --preview-digest",
    "sites:prepare": "npm run build:public && node scripts/sites-publication.mjs --prepare",
    "cloudbase:check": "node scripts/cloudbase-publication.mjs --check",
    "cloudbase:login": "tcb login",
    "cloudbase:detail": "node scripts/cloudbase-publication.mjs --detail --skip-build",
    "cloudbase:deploy": "node scripts/cloudbase-publication.mjs --deploy",
    "publication:deploy": "node scripts/publication.mjs --deploy",
    "publication:check": "node scripts/publication.mjs --check",
    "publication:verify": "node scripts/publication.mjs --check --verify-public",
    "server:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-public-server.ps1 -StartNow",
    "server:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-public-server.ps1",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build:public",
    "build:public": "npm run data:sync-main && npm run typecheck && vite build --mode public",
    "build:admin": "npm run data:sync-main && npm run typecheck && vite build --mode admin",
    "preview": "vite preview --host 127.0.0.1",
    "preview:public": "node scripts/serve-public-dist.mjs",
    "preview:lan": "npm run preview:public",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "health:run": "node scripts/local-watchdog.mjs --port 43127",
    "health:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local-watchdog.ps1 -Port 43127",
    "health:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-local-watchdog.ps1",
    "public:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-public-link.ps1",
    "status:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-local.ps1",
    "deploy:cloudflare": "npm run build:public && npx wrangler pages deploy dist --project-name wagmi-daily",
    "deploy:vercel": "npm run build:public && npx vercel deploy dist --prod",
    "ai:reconcile": "node scripts/reconcile-ai-collection.mjs",
    "ai:discovery:prepare": "node scripts/ai-discovery-review.mjs --prepare",
    "ai:discovery:check": "node scripts/ai-discovery-review.mjs --check",
    "ai:media:discover": "node scripts/discover-ai-media.mjs",
    "ai:media:dry": "node scripts/discover-ai-media.mjs --dry-run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "antd": "latest",
    "fast-xml-parser": "^5.10.1",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "undici": "^7.30.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.23"
  }
}
